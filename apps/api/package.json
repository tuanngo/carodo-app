{
  "name": "@carodo/api",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    "./web-contract": "./src/rpc/types/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8080 --inspector-port 9280",
    "dev:lan": "wrangler dev --ip 0.0.0.0 --port 8080 --inspector-port 9280",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "test:changed": "vitest run --changed",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "wrangler types --strict-vars=false --check && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply DB --local && pnpm run db:seed",
    "db:seed": "wrangler d1 execute DB --local --file=seeds/username-policies.sql"
  },
  "dependencies": {
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
