# Copy to .env.deploy at the repository root (gitignored).
# Read only by scripts/wrangler.mjs, which every deploy, migrate and secret command goes through
# (docs/operations/deploy.md). An account id and an optional profile name only: never a token or a secret.

# The Cloudflare account that holds the carodo.app zone and both environments:
# the 32-character id in the dashboard's URL, or `wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=

# Optional Wrangler auth profile (`pnpm --filter @carodo/api exec wrangler auth create carodo`),
# when this machine logs into more than one Cloudflare account. Leave empty to use `wrangler login`.
WRANGLER_PROFILE=
