{
  "$schema": "node_modules/wrangler/config-schema.json",
  // carodo-web: the public share page, HTML rendered on the server with no client script.
  // It owns no data store: everything it shows comes from the api's `WebRpc` through the `API`
  // service binding, never from the api's public URL (docs/decisions/0001).
  // This top level is local development; environments come with the first deploy.
  "name": "carodo-web",
  "main": "./src/index.tsx",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  // A share link's token is in the URL, and invocation logs record the URL: they stay off.
  // Our own structured log lines stay, and never carry a token.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "services": [{ "binding": "API", "service": "carodo-api", "entrypoint": "WebRpc" }]
}
