{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/*.md", "!**/*.yaml", "!**/*.yml", "!**/worker-configuration.d.ts", "!**/wrangler.jsonc"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["apps/api/src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "hono",
                      "hono/*",
                      "**/services/**",
                      "**/http/**",
                      "**/routes/**",
                      "**/rpc/**",
                      "**/jobs/**"
                    ],
                    "message": "lib/ holds plain helpers: it imports nothing above it and no Hono (docs/architecture.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/services/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["hono", "hono/*", "**/http/**", "**/routes/**", "**/rpc/**", "**/jobs/**"],
                    "message": "A service returns a Result and never sees a transport or a Response (ADR 0001, docs/architecture.md)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@carodo/api", "@carodo/api/*", "!@carodo/api/web-contract", "**/api/src/**"],
                    "message": "The web reaches the api only through the API service binding; import its types from @carodo/api/web-contract (docs/decisions/0001)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
